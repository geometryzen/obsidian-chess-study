{
	"name": "chess-study",
	"version": "1.1.0",
	"description": "A chess study helper and PGN viewer/editor Plugin for Obsidian.",
	"keywords": [
		"chess",
		"obsidian"
	],
	"license": "GPL-3.0-or-later",
	"author": "Christoph Lindstädt",
	"main": "main.js",
	"scripts": {
		"build": "npm run clean && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"clean": "rimraf ./dist",
		"dev": "node esbuild.config.mjs",
		"format": "prettier --write .",
		"lint": "eslint .",
		"prepare": "husky install",
		"deploy": "npm run build && node deploy.mjs",
		"test": "jest",
		"test:watch": "jest --watch",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mliebelt/pgn-parser": "1.4.19",
		"@mui/material": "^9.6.0",
		"@tiptap/extension-bold": "3.32.0",
		"@tiptap/extension-document": "3.32.0",
		"@tiptap/extension-paragraph": "3.32.0",
		"@tiptap/extension-text": "3.32.0",
		"@tiptap/pm": "3.32.0",
		"@tiptap/react": "3.32.0",
		"@tiptap/starter-kit": "3.32.0",
		"@tsconfig/node20": "20.1.11",
		"chess.js": "1.4.0",
		"chessground": "9.2.1",
		"immer": "^11.2.13",
		"lucide-react": "1.83.0",
		"nanoid": "6.0.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"stockfish": "10.0.2",
		"use-immer": "^0.11.0"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "5.30.7",
		"@eslint/js": "^10.0.1",
		"@mliebelt/pgn-types": "1.0.4",
		"@types/jest": "30.0.0",
		"@types/node": "26.6.11",
		"@types/react": "19.3.3",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/eslint-plugin": "8.74.0",
		"@typescript-eslint/parser": "8.74.0",
		"builtin-modules": "5.5.0",
		"esbuild": "0.28.2",
		"eslint": "^10.16.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"globals": "^17.14.0",
		"husky": "9.1.7",
		"jest": "30.5.2",
		"obsidian": "1.14.4",
		"prettier": "3.10.1",
		"prettier-plugin-organize-imports": "4.3.0",
		"pretty-quick": "4.2.2",
		"rimraf": "6.1.4",
		"ts-jest": "^29.4.15",
		"ts-loader": "9.6.2",
		"ts-node": "10.9.2",
		"tslib": "2.9.1",
		"tsm": "2.3.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.74.0"
	},
	"allowScripts": {
		"file:../../chess.js": true,
		"@parcel/watcher@2.6.0": true,
		"unrs-resolver@1.12.2": true,
		"esbuild@0.28.2": true
	}
}
